# game/script.rpy:689
translate malay start_73d62284:

    # centered "Disclaimer:\n\nThis session includes some questions about stress from the Depression Anxiety Stress Scales (DASS). \ These questions are used for research only. They are not a medical test and cannot diagnose or treat mental health conditions.\n\n{size=-10}This research was supported by the Ministry of Higher Education (MoHE) of Malaysia through the Fundamental Research Grant Scheme (FRGS/1/2024/ICT02/UUM/02/1){/size}"
    centered "Penafian:\n\nSesi ini mengandungi beberapa soalan tentang tekanan daripada Depression Anxiety Stress Scales (DASS). Soalan-soalan ini digunakan untuk penyelidikan sahaja. Ia bukan ujian perubatan dan tidak boleh mendiagnosis atau merawat masalah kesihatan mental.\n\n{size=-10}Penyelidikan ini disokong oleh Kementerian Pendidikan Tinggi (KPT) Malaysia melalui Skim Geran Penyelidikan Fundamental (FRGS/1/2024/ICT02/UUM/02/1){/size}"

# game/script.rpy
translate malay start_d4d0d056:

    # e "Session resume for [user_name]."
    e "Sesi disambung semula untuk [user_name]."

# game/script.rpy
translate malay start_69afadcd:

    # e "Your last stress level is in the high range."
    e "Tahap tekanan terakhir anda berada dalam julat yang tinggi."

# game/script.rpy
translate malay start_40833bb5:

    # e "Your last stress level is in the low range."
    e "Tahap tekanan terakhir anda berada dalam julat yang rendah."

# game/script.rpy
translate malay start_21429ec7:

    # e "This is Hana."
    e "Ini Hana."

# game/script.rpy
translate malay start_bf758c03:

    # e "And you...?"
    e "Dan anda...?"

# game/script.rpy
translate malay start_d2b704e8:

    # e "User identify as [user_name]."
    e "Pengguna dikenal pasti sebagai [user_name]."

# game/script.rpy
translate malay start_555b7c9b:

    # e "My name mean \"flower\" in Japanese, and \"happiness\" in Arabic."
    e "Nama saya bermaksud \"bunga\" dalam bahasa Jepun, dan \"kebahagiaan\" dalam bahasa Arab."

# game/script.rpy
translate malay start_7f74d295:

    # e "Input received. Session begin now."
    e "Input diterima. Sesi bermula sekarang."

# game/script.rpy
translate malay start_7f74d295_1:

    # e "Input received. Session begin now."
    e "Input diterima. Sesi bermula sekarang."

# game/script.rpy
translate malay start_7f74d295_2:

    # e "Input received. Session begin now."
    e "Input diterima. Sesi bermula sekarang."

# game/script.rpy
translate malay start_8eaf8ebb:

    # e "Before continue, you want background music for this session?"
    e "Sebelum kita teruskan, adakah anda mahu muzik latar sepanjang sesi ini?"

# game/script.rpy
translate malay start_766b831c:

    # e "You can choose any one."
    e "Anda boleh memilih mana-mana."

# game/script.rpy
translate malay start_c732fdaa:

    # e "Music will play in background."
    e "Muzik akan dimainkan di latar belakang."

# game/script.rpy
translate malay start_8b1446cc:

    # e "No music will play."
    e "Tiada muzik akan dimainkan."

# game/script.rpy
translate malay start_107421a7:

    # e "Please select your state today."
    e "Sila pilih keadaan anda hari ini."

# game/script.rpy
translate malay start_5a949fc9:

    # e "How is your day until now?"
    e "Bagaimana hari anda setakat ini?"

# game/script.rpy
translate malay start_ddcc643f:

    # e "Today, anything make you feel stress or upset?"
    e "Hari ini, ada apa-apa yang membuatkan anda berasa tertekan atau kecewa?"

# game/script.rpy
translate malay start_1d3e3cf9:

    # e "One more question."
    e "Satu soalan lagi."

# game/script.rpy
translate malay start_e345b9e0:

    # e "Identify one good event that happen recently."
    e "Kenal pasti satu peristiwa baik yang berlaku baru-baru ini."

# game/script.rpy
translate malay stress_input_6e654e04:

    # e "[q!t]"
    e "[q!t]"

# game/script.rpy
translate malay stress_input_73ba8410:

    # e "All response recorded."
    e "Semua jawapan direkodkan."

# game/script.rpy
translate malay stress_input_d88c88d3:

    # e "If you ever feel unsafe, contact Befrienders or a healthcare professional. External support options are available."
    e "Jika anda berasa tidak selamat, sila hubungi Befrienders atau seorang profesional penjagaan kesihatan. Pilihan sokongan luar tersedia."

# game/script.rpy
translate malay stress_input_200835c7:

    # e "Now start one short calming exercise."
    e "Sekarang, mulakan satu latihan menenangkan diri yang ringkas."

# game/script.rpy
translate malay stress_input_28eb1454:

    # e "Next section will identify stress factor and possible action."
    e "Bahagian seterusnya akan mengenal pasti faktor tekanan dan tindakan yang mungkin."

# game/script.rpy
translate malay session_end_loop_2ff46385:

    # e "That exercise is finish."
    e "Latihan itu telah selesai."

# game/script.rpy
translate malay session_end_loop_12bb3fea:

    # e "You can do one more exercise, or end the session here."
    e "Anda boleh melakukan satu lagi latihan, atau menamatkan sesi di sini."

# game/script.rpy
translate malay session_end_loop_7bcab9e6:

    # e "One short breathing exercise is available before end."
    e "Satu latihan pernafasan ringkas tersedia sebelum menamatkan sesi."

# game/script.rpy
translate malay session_end_loop_f5f150d1:

    # e "Select to proceed or not."
    e "Sila pilih sama ada untuk meneruskan."

# game/script.rpy
translate malay session_end_loop_4f2eba82:

    # e "One short calming exercise is available before end."
    e "Satu latihan menenangkan diri yang ringkas tersedia sebelum menamatkan sesi."

# game/script.rpy
translate malay session_end_loop_f5f150d1_1:

    # e "Select to proceed or not."
    e "Sila pilih sama ada untuk meneruskan."

# game/script.rpy
translate malay affective_input_6e654e04:

    # e "[q!t]"
    e "[q!t]"

# game/script.rpy
translate malay affective_input_821fa6e3:

    # e "For difficulty to focus, break the task into small step and do one by one. This is one practical way to stay on track."
    e "Bagi kesukaran menumpukan perhatian, pecahkan tugas kepada langkah yang lebih kecil dan lakukan satu demi satu. Ini satu cara praktikal untuk kekal fokus."

# game/script.rpy
translate malay affective_input_7bcab9e6:

    # e "One short breathing exercise is available before end."
    e "Satu latihan pernafasan ringkas tersedia sebelum menamatkan sesi."

# game/script.rpy
translate malay affective_input_f8e3f04a:

    # e "For worry that always come, set one fixed time to handle your concern. This stop it from disturb your other activity."
    e "Bagi kebimbangan yang sentiasa datang, tetapkan satu masa khusus untuk menangani kerisauan anda. Ini menghalangnya daripada mengganggu aktiviti anda yang lain."

# game/script.rpy
translate malay affective_input_e7168a4d:

    # e "For sleep that is disturb, keep a same sleep schedule and reduce screen before bed. This can improve your rest."
    e "Bagi tidur yang terganggu, kekalkan jadual tidur yang sama dan kurangkan penggunaan skrin sebelum tidur. Ini dapat memperbaiki rehat anda."

# game/script.rpy
translate malay affective_input_6e654e04_1:

    # e "[q!t]"
    e "[q!t]"

# game/script.rpy
translate malay affective_input_bd399850:

    # e "To balance caregiving with work or study, list down your task and rank by priority. Then focus the most urgent one first."
    e "Untuk mengimbangi tugas penjagaan dengan kerja atau pengajian, senaraikan tugas anda dan susun mengikut keutamaan. Kemudian fokus pada yang paling mendesak dahulu."

# game/script.rpy
translate malay affective_input_dc858f9d:

    # e "To manage household task with caregiving, group the same task together and delegate if can. This save time and energy."
    e "Untuk menguruskan kerja rumah bersama tugas penjagaan, kumpulkan tugas yang sama dan agihkan kepada orang lain jika boleh. Ini menjimatkan masa dan tenaga."

# game/script.rpy
translate malay affective_input_5b0c9491:

    # e "To protect time for yourself, put short fixed break into your day and treat it like a fixed appointment."
    e "Untuk melindungi masa untuk diri sendiri, masukkan waktu rehat pendek yang tetap dalam hari anda dan anggap ia seperti satu janji temu yang tetap."

# game/script.rpy
translate malay affective_input_155b3aaf:

    # e "For unexpected caregiving need, prepare a backup plan and contact list early. This reduce last-minute pressure."
    e "Bagi keperluan penjagaan yang tidak dijangka, sediakan pelan sokongan dan senarai hubungan lebih awal. Ini mengurangkan tekanan saat akhir."

# game/script.rpy
translate malay affective_input_6e654e04_2:

    # e "[q!t]"
    e "[q!t]"

# game/script.rpy
translate malay affective_input_2c849847:

    # e "For worry about the person you care for, focus what is in your control. Note down the specific concern to discuss with their healthcare provider."
    e "Bagi kebimbangan tentang orang yang anda jaga, fokus pada perkara yang berada dalam kawalan anda. Catatkan kerisauan tertentu untuk dibincangkan dengan penyedia penjagaan kesihatan mereka."

# game/script.rpy
translate malay affective_input_2acaf889:

    # e "With too many responsibility, prioritise the essential task. Postpone or delegate the non-urgent one to free up capacity."
    e "Apabila terlalu banyak tanggungjawab, utamakan tugas yang penting. Tangguhkan atau agihkan tugas yang tidak mendesak untuk melapangkan kapasiti."

# game/script.rpy
translate malay affective_input_073d232a:

    # e "For limited rest or support, contact community resource or respite-care service. This can give additional help."
    e "Bagi rehat atau sokongan yang terhad, hubungi sumber komuniti atau perkhidmatan penjagaan rehat. Ini boleh memberikan bantuan tambahan."

# game/script.rpy
translate malay affective_input_f34b590a:

    # e "To identify the specific source of the pressure is one useful first step to address it."
    e "Mengenal pasti punca khusus tekanan itu ialah satu langkah pertama yang berguna untuk menanganinya."

# game/script.rpy
translate malay affective_input_1b22cb13:

    # e "When stress build up like this, it help to take one priority at a time, not everything at once."
    e "Apabila tekanan terkumpul seperti ini, lebih baik menangani satu keutamaan pada satu masa, bukan semuanya serentak."

# game/script.rpy
translate malay affective_input_386997ed:

    # e "Write down the task and rank by urgency. This can support workload organisation."
    e "Tuliskan tugas dan susun mengikut tahap kemendesakan. Ini dapat membantu penyusunan beban kerja."

# game/script.rpy
translate malay affective_input_b38ea6c3:

    # e "One good starting point is to pick your most urgent task and focus on it first."
    e "Satu permulaan yang baik adalah dengan memilih tugas yang paling mendesak dan memberi tumpuan kepadanya dahulu."

# game/script.rpy
translate malay affective_input_687ac655:

    # e "Non-essential task can defer to reduce immediate task load."
    e "Tugas yang tidak penting boleh ditangguhkan untuk mengurangkan beban tugas serta-merta."

# game/script.rpy
translate malay post_response_fc04f621:

    # e "[feedback_prompt!t]"
    e "[feedback_prompt!t]"

# game/script.rpy
translate malay post_response_5921ebe8:

    # e "Response is recorded."
    e "Jawapan direkodkan."

# game/script.rpy
translate malay calming_loop_73b0a6f0:

    # e "Another support option will be use now."
    e "Satu lagi pilihan sokongan akan digunakan sekarang."

# game/script.rpy
translate malay calming_loop_91a4683e:

    # e "Select your stress state now."
    e "Sila pilih tahap tekanan anda sekarang."

# game/script.rpy
translate malay calming_loop_aab89ee5:

    # e "The exercise stop here."
    e "Latihan dihentikan di sini."

# game/script.rpy
translate malay calming_loop_077bb859:

    # e "This is the end of the exercise."
    e "Ini penghujung latihan ini."

# game/script.rpy
translate malay calming_loop_7fe2e8cb:

    # e "These technique can repeat after the session end."
    e "Teknik-teknik ini boleh diulang selepas sesi tamat."

# game/script.rpy
translate malay calming_loop_8d4e2152:

    # e "Now try a different exercise."
    e "Sekarang cuba latihan yang berbeza."

# game/script.rpy
translate malay calming_loop_8465bc6f:

    # e "This is the last exercise."
    e "Ini latihan yang terakhir."

# game/script.rpy
translate malay calming_loop_56e19297:

    # e "If high stress persists, consider Befrienders or professional healthcare support."
    e "Jika tekanan yang tinggi berterusan, pertimbangkan untuk menghubungi Befrienders atau sokongan penjagaan kesihatan profesional."

# game/script.rpy
translate malay deliver_technique_a9ae181e:

    # e "This is breathing exercise."
    e "Ini latihan pernafasan."

# game/script.rpy
translate malay deliver_technique_43fdc786:

    # e "Under stress, breathing become more quick and more shallow."
    e "Ketika tertekan, pernafasan menjadi lebih cepat dan lebih cetek."

# game/script.rpy
translate malay deliver_technique_093364ae:

    # e "Slow the breath can lower the physical sign of stress."
    e "Memperlahankan pernafasan dapat mengurangkan tanda fizikal tekanan."

# game/script.rpy
translate malay deliver_technique_646f8169:

    # e "Follow this pattern."
    e "Ikut corak ini."

# game/script.rpy
translate malay deliver_technique_aa4c4338:

    # e "A few slow breath can reduce the body stress response."
    e "Beberapa nafas yang perlahan dapat mengurangkan tindak balas tekanan badan."

# game/script.rpy
translate malay deliver_technique_728d8ebb:

    # e "This is the 5-4-3-2-1 grounding technique."
    e "Ini teknik grounding 5-4-3-2-1."

# game/script.rpy
translate malay deliver_technique_77912ffc:

    # e "It bring your attention back to the present using the senses."
    e "Ia mengalihkan perhatian anda kembali kepada masa kini menggunakan deria."

# game/script.rpy
translate malay deliver_technique_4be2586f:

    # e "Identify 5 things you can see."
    e "Kenal pasti 5 perkara yang anda boleh lihat."

# game/script.rpy
translate malay deliver_technique_b0bda992:

    # e "Identify 4 things you can touch."
    e "Kenal pasti 4 perkara yang anda boleh sentuh."

# game/script.rpy
translate malay deliver_technique_7d8ba171:

    # e "Identify 3 sounds you can hear."
    e "Kenal pasti 3 bunyi yang anda boleh dengar."

# game/script.rpy
translate malay deliver_technique_0393a625:

    # e "Identify 2 things you can smell, or you remember the smell."
    e "Kenal pasti 2 perkara yang anda boleh hidu, atau yang anda ingat baunya."

# game/script.rpy
translate malay deliver_technique_2f2dab18:

    # e "Identify 1 thing you can taste."
    e "Kenal pasti 1 perkara yang anda boleh rasa."

# game/script.rpy
translate malay deliver_technique_134f4cbd:

    # e "This grounding can stop the racing thought and bring focus back to the present."
    e "Teknik grounding ini dapat menghentikan fikiran yang berkecamuk dan mengembalikan tumpuan kepada masa kini."

# game/script.rpy
translate malay deliver_technique_d88b23b2:

    # e "This is body scan exercise."
    e "Ini latihan imbasan badan."

# game/script.rpy
translate malay deliver_technique_3a525140:

    # e "Stress often produce physical tension without you notice."
    e "Tekanan sering menghasilkan ketegangan fizikal tanpa anda sedari."

# game/script.rpy
translate malay deliver_technique_13e120b3:

    # e "The common area is the shoulder, jaw, neck, and hand."
    e "Kawasan yang biasa ialah bahu, rahang, leher, dan tangan."

# game/script.rpy
translate malay deliver_technique_aafda28b:

    # e "Direct your attention to your body, one area at one time."
    e "Tumpukan perhatian anda kepada badan, satu kawasan pada satu masa."

# game/script.rpy
translate malay deliver_technique_55817f54:

    # e "Shoulder: let it drop away from your ear."
    e "Bahu: biarkan ia turun menjauhi telinga anda."

# game/script.rpy
translate malay deliver_technique_293ef769:

    # e "Jaw: let it loose."
    e "Rahang: biarkan ia mengendur."

# game/script.rpy
translate malay deliver_technique_7b78a24a:

    # e "Hand: let it rest."
    e "Tangan: biarkan ia berehat."

# game/script.rpy
translate malay deliver_technique_78edc1eb:

    # e "After that, scan the neck, chest, and stomach for tension."
    e "Selepas itu, imbas leher, dada, dan perut untuk mengesan ketegangan."

# game/script.rpy
translate malay deliver_technique_346c0b04:

    # e "Where you find tension, just note it, do not try to change it."
    e "Di mana anda menemui ketegangan, perhatikannya sahaja, jangan cuba mengubahnya."

# game/script.rpy
translate malay deliver_technique_609d56b5:

    # e "To notice where the tension is, that is the first step to release it."
    e "Menyedari di mana ketegangan berada ialah langkah pertama untuk melepaskannya."

# game/script.rpy
translate malay deliver_technique_41a03653:

    # e "This is gratitude exercise."
    e "Ini latihan kesyukuran."

# game/script.rpy
translate malay deliver_technique_18632b78:

    # e "Under stress, our attention narrow to the problem and the unfinished task."
    e "Ketika tertekan, perhatian kita menyempit kepada masalah dan tugas yang belum selesai."

# game/script.rpy
translate malay deliver_technique_050e3088:

    # e "To note something positive can balance that bias."
    e "Memperhatikan sesuatu yang positif dapat mengimbangi kecenderungan itu."

# game/script.rpy
translate malay deliver_technique_6de8064f:

    # e "Identify one thing that is good or useful recently."
    e "Kenal pasti satu perkara yang baik atau berguna kebelakangan ini."

# game/script.rpy
translate malay deliver_technique_c75938a4:

    # e "It do not need to be significant."
    e "Ia tidak semestinya sesuatu yang besar."

# game/script.rpy
translate malay deliver_technique_69bf5118:

    # e "Example: a conversation, a meal, or a quiet moment."
    e "Contohnya: satu perbualan, satu hidangan, atau satu saat yang tenang."

# game/script.rpy
translate malay deliver_technique_ded42d89:

    # e "Hold that example in your mind for a few second."
    e "Pegang contoh itu dalam fikiran anda selama beberapa saat."

# game/script.rpy
translate malay deliver_technique_60d7d703:

    # e "A short positive memory can shift your attention away from the stressor."
    e "Ingatan positif yang ringkas dapat mengalihkan perhatian anda daripada punca tekanan."

# game/script.rpy
translate malay deliver_technique_72a36ce1:

    # e "This is guided imagery exercise."
    e "Ini latihan imaginasi berpandu."

# game/script.rpy
translate malay deliver_technique_748ac020:

    # e "It involve to picture a calm location in detail."
    e "Ia melibatkan membayangkan satu lokasi yang tenang secara terperinci."

# game/script.rpy
translate malay deliver_technique_332e5587:

    # e "It is commonly use to reduce stress at that moment."
    e "Ia lazim digunakan untuk mengurangkan tekanan pada ketika itu."

# game/script.rpy
translate malay deliver_technique_eb29f986:

    # e "Choose a place you feel calm, such as a beach, a lake, or a forest."
    e "Pilih satu tempat yang anda rasa tenang, seperti pantai, tasik, atau hutan."

# game/script.rpy
translate malay deliver_technique_9765f73c:

    # e "Picture the scene."
    e "Bayangkan suasana itu."

# game/script.rpy
translate malay deliver_technique_1833d5f6:

    # e "Note what you can see: the colour, the light, and the detail."
    e "Perhatikan apa yang anda boleh lihat: warna, cahaya, dan perincian."

# game/script.rpy
translate malay deliver_technique_b533f47c:

    # e "Note the sound, such as wave, bird, or wind."
    e "Perhatikan bunyi, seperti ombak, burung, atau angin."

# game/script.rpy
translate malay deliver_technique_8b579ab6:

    # e "Note the physical sensation, such as warm, cool air, or the ground under your feet."
    e "Perhatikan sensasi fizikal, seperti kehangatan, udara yang nyaman, atau tanah di bawah kaki anda."

# game/script.rpy
translate malay deliver_technique_5fc73334:

    # e "Take one slow breath in."
    e "Tarik satu nafas yang perlahan."

# game/script.rpy
translate malay deliver_technique_6a8e7eb0:

    # e "And out."
    e "Dan hembuskan."

# game/script.rpy
translate malay deliver_technique_6aa3b6ea:

    # e "Stay with the image for a few moment."
    e "Kekal dengan gambaran itu untuk beberapa ketika."

# game/script.rpy
translate malay deliver_technique_17443f7c:

    # e "You can come back to this image whenever your stress increase."
    e "Anda boleh kembali kepada gambaran ini apabila tekanan anda meningkat."

# game/script.rpy
translate malay phase5_close_update_d4f07673:

    # e "Session complete."
    e "Sesi selesai."

# game/script.rpy
translate malay phase5_close_update_3deac59d:

    # e "If high stress persists, consider contacting Befrienders (03-7627 2929) or a healthcare professional."
    e "Jika tekanan yang tinggi berterusan, pertimbangkan untuk menghubungi Befrienders (03-7627 2929) atau seorang profesional penjagaan kesihatan."

# game/script.rpy
translate malay phase5_close_update_5c54b418:

    # e "A new session can start later."
    e "Sesi baharu boleh dimulakan kemudian."


